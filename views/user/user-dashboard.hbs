<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard | SYS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/variables.css">
    <link rel="stylesheet" href="/stylesheets/main.css">
    <link rel="stylesheet" href="/stylesheets/components.css">
</head>
<body class="bg-light min-vh-100 d-flex flex-column user-dashboard">
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand logo mb-0 flex-shrink-0 py-0 d-flex align-items-center me-2" href="#hero">
                <img src="/images/Gemini_Generated_Image_41luhh41luhh41lu-removebg-preview.png" alt="SYS logo" class="navbar-logo">
                <span class="visually-hidden">SYS</span>
            </a>
            <div class="ms-auto">
                <a href="/logout" class="btn btn-outline-success">Logout</a>
            </div>
        </div>
    </nav>

    <main class="container py-5">
        <div class="card shadow-sm dashboard-section">
            <div class="card-body">
                <h1 class="h3 mb-3">User Dashboard</h1>
                <p class="mb-1">Hello, <strong>{{user.Name}}</strong>.</p>
                <p class="text-muted">You are signed in as a <strong>{{user.Role}}</strong>.</p>
                <div class="row g-4 mt-4">
                    <div class="col-md-3">
                        <div class="border rounded p-4 bg-white h-100">
                            <h5 class="mb-3">Zones</h5>
                            <div id="user-zone-list"></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-4 bg-white h-100">
                            <h5 class="mb-3">Circles</h5>
                            <div id="user-circle-list"></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-4 bg-white h-100">
                            <h5 class="mb-3">Units</h5>
                            <div id="user-unit-list"></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-4 bg-white h-100">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h5 class="mb-0">Programme Status</h5>
                                <button id="user-refresh-btn" type="button" class="btn btn-sm btn-outline-secondary">Refresh</button>
                            </div>
                            <div id="user-last-refresh" class="text-muted small mb-3">Last updated just now.</div>
                            <div id="user-project-summary" class="mb-3">Select a Unit to view progress.</div>
                            <div class="text-muted" id="selected-location">No Unit selected</div>
                        </div>
                    </div>
                </div>
                <div class="card mt-4">
                    <div class="card-body">
                        <h4 class="mb-3">Assigned Programmes</h4>
                        <div id="user-project-list" class="text-muted">Select a Unit to load its programmes.</div>
                    </div>
                </div>

                <div class="card mt-4">
                    <div class="card-body">
                        <h4 class="mb-3">Payment</h4>
                        <p class="text-muted mb-3">Complete your payment using Razorpay to proceed with your application.</p>
                        <form class="razorpay-wrapper">
                            <script src="https://checkout.razorpay.com/v1/payment-button.js" data-payment_button_id="pl_SwgSNOd4aS1Q1b" async></script>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="mt-auto py-3 bg-white border-top">
        <div class="container text-muted text-center">&copy; 2026 Sunni Yuvajana Sangham (SYS) Kerala</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="/javascripts/user-dashboard.js"></script>
</body>
</html>
