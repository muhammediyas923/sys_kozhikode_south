<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Dashboard | SYS Unit</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/variables.css">
  <link rel="stylesheet" href="/stylesheets/dashboard.css">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<body class="dashboard-body">
  <div class="ds-sidebar-overlay" id="sidebar-overlay"></div>

  <!-- SIDEBAR -->
  <aside class="ds-sidebar" id="sidebar">
    <div class="ds-sidebar-brand">
      <img src="/images/Gemini_Generated_Image_41luhh41luhh41lu-removebg-preview.png" alt="SYS" class="ds-sidebar-logo">
      <div>
        <div class="ds-sidebar-title">{{user.unitName}}</div>
        <div class="ds-sidebar-subtitle">{{user.circle}} · {{user.zone}}</div>
      </div>
    </div>

    <nav class="ds-sidebar-nav">
      <div class="ds-nav-section-title">My Dashboard</div>
      <a href="/unit-dashboard" class="ds-nav-link active">
        <i class="ph ph-squares-four"></i> Overview
      </a>
      <a href="#programs-section" class="ds-nav-link">
        <i class="ph ph-clipboard-text"></i> My Programs
        <span class="ds-nav-badge" id="pending-badge">...</span>
      </a>
      <a href="#notifications-section" class="ds-nav-link">
        <i class="ph ph-bell"></i> Notifications
        <span class="ds-nav-badge d-none" id="notif-nav-badge">0</span>
      </a>
    </nav>

    <div class="ds-sidebar-footer">
      <div class="ds-user-widget">
        <div class="ds-user-avatar" id="unit-avatar">U</div>
        <div class="ds-user-info">
          <div class="ds-user-name">{{user.username}}</div>
          <div class="ds-user-role">Unit User</div>
        </div>
        <a href="/logout" class="ds-logout-btn" title="Logout"><i class="ph ph-sign-out"></i></a>
      </div>
    </div>
  </aside>

  <!-- MAIN -->
  <div class="ds-main">
    <!-- TOP BAR -->
    <header class="ds-topbar">
      <button type="button" class="ds-topbar-menu-btn" id="sidebar-toggle" onclick="window.toggleSidebar?.()"><i class="ph ph-list"></i></button>
      <div class="ds-topbar-title">My Dashboard <span>/ Overview</span></div>
      <div style="position:relative;">
        <button class="ds-notif-btn" id="notif-btn" aria-label="Notifications">
          <i class="ph ph-bell"></i>
          <span class="ds-notif-badge d-none" id="notif-count">0</span>
        </button>
        <div class="ds-notif-panel" id="notif-panel">
          <div class="ds-notif-panel-header">
            <span>Notifications</span>
            <button class="ds-btn ds-btn-sm ds-btn-outline" id="mark-all-read" style="padding:3px 8px;font-size:0.72rem;">Mark all read</button>
          </div>
          <div class="ds-notif-list" id="notif-list">
            <div class="ds-loading-overlay"><div class="ds-spinner"></div></div>
          </div>
        </div>
      </div>
    </header>

    <!-- CONTENT -->
    <main class="ds-content">
      <!-- Welcome Header -->
      <div class="ds-page-header">
        <h1>Welcome, {{user.unitName}} 👋</h1>
        <p>
          <i class="ph ph-map-pin" style="color:var(--ds-primary);"></i> {{user.zone}} &nbsp;·&nbsp;
          <i class="ph ph-circles-three" style="color:var(--ds-primary);"></i> {{user.circle}}
        </p>
      </div>

      <!-- STAT CARDS -->
      <div class="ds-stat-grid mb-4" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));">
        <div class="ds-stat-card" style="--card-accent:#f5a623; --card-icon-bg:#fef3d8; --card-icon-color:#d97706;">
          <div class="ds-stat-icon"><i class="ph ph-clipboard-text"></i></div>
          <div class="ds-stat-value" id="stat-total">—</div>
          <div class="ds-stat-label">Total Programs</div>
        </div>
        <div class="ds-stat-card" style="--card-accent:#16a34a; --card-icon-bg:#f0fdf4; --card-icon-color:#16a34a;">
          <div class="ds-stat-icon"><i class="ph ph-check-circle"></i></div>
          <div class="ds-stat-value" id="stat-done">—</div>
          <div class="ds-stat-label">Completed</div>
        </div>
        <div class="ds-stat-card" style="--card-accent:#e53e3e; --card-icon-bg:#fff5f5; --card-icon-color:#e53e3e;">
          <div class="ds-stat-icon"><i class="ph ph-clock"></i></div>
          <div class="ds-stat-value" id="stat-pending">—</div>
          <div class="ds-stat-label">Pending</div>
        </div>
        <div class="ds-stat-card" style="--card-accent:#0284c7; --card-icon-bg:#eff6ff; --card-icon-color:#0284c7;">
          <div class="ds-stat-icon"><i class="ph ph-percent"></i></div>
          <div class="ds-stat-value" id="stat-pct">—%</div>
          <div class="ds-stat-label">Completion Rate</div>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="ds-card mb-4">
        <div class="ds-card-body" style="padding: 16px 20px;">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span style="font-size:0.875rem; font-weight:600; color:var(--ds-text);">Overall Progress</span>
            <span id="progress-text" style="font-size:0.875rem; color:var(--ds-text-muted);">Loading...</span>
          </div>
          <div class="ds-progress">
            <div class="ds-progress-bar" id="progress-bar" style="width:0%;"></div>
          </div>
        </div>
      </div>

      <!-- PROGRAMS GRID -->
      <div id="programs-section">
        <div class="d-flex align-items-center justify-content-between mb-3" style="gap:16px; flex-wrap:wrap;">
          <div>
            <h2 style="font-size:1.1rem; font-weight:700; margin:0;">
              <i class="ph ph-clipboard-text" style="color:var(--ds-primary);"></i> My Programs
            </h2>
            <div id="program-count-label" style="font-size:0.9rem; color:var(--ds-text-muted); margin-top:4px;">Loading programs…</div>
            <div style="font-size:0.85rem; color:var(--ds-text-muted); margin-top:4px;">Server programs: {{programs.length}}</div>
          </div>
          <button class="ds-btn ds-btn-outline ds-btn-sm" id="refresh-btn">
            <i class="ph ph-arrows-clockwise"></i> Refresh
          </button>
        </div>

        <!-- Filter -->
        <div class="ds-filter-bar mb-3" style="padding:12px 16px;">
          <div class="ds-search-box" style="max-width:220px;">
            <i class="ph ph-magnifying-glass"></i>
            <input type="text" id="prog-search" placeholder="Search programs..." style="background:white;">
          </div>
          <select class="ds-form-control ds-form-select" style="max-width:160px;" id="prog-filter">
            <option value="all">All Programs</option>
            <option value="pending">Pending</option>
            <option value="completed">Completed</option>
          </select>
        </div>

        <div id="programs-grid" class="row g-3">
          {{#if programs.length}}
            {{#each programs}}
              <div class="col-md-6 col-lg-4">
                <div class="ds-program-card {{#if completed}}completed{{/if}}" data-id="{{_id}}">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <h3 class="ds-program-title mb-0">{{title}}</h3>
                    {{#unless published}}<span class="ds-badge ds-badge-warning" style="font-size:0.72rem;">Draft</span>{{/unless}}
                  </div>
                  <p class="ds-program-desc">{{#if description}}{{description}}{{else}}No description provided.{{/if}}</p>
                  <div class="ds-program-meta">
                    <div class="ds-program-meta-item">
                      <i class="ph ph-calendar"></i> Due: {{#if dueDate}}{{dueDate}}{{else}}No due date{{/if}}
                    </div>
                  </div>
                  <div class="ds-completion-toggle">
                    <input class="ds-checkbox prog-checkbox" type="checkbox" id="check-{{_id}}" data-id="{{_id}}" {{#if completed}}checked{{/if}}>
                    <label class="ds-checkbox-label" for="check-{{_id}}">
                      {{#if completed}}Marked as Completed{{else}}Mark as Completed{{/if}}
                    </label>
                  </div>
                </div>
              </div>
            {{/each}}
          {{else}}
            <div class="col-12">
              <div class="ds-empty">
                <i class="ph ph-clipboard-text ds-empty-icon"></i>
                <h3>No programs available</h3>
                <p>All admin-created programs should show here once they are added.</p>
              </div>
            </div>
          {{/if}}
        </div>
      </div>

      <!-- NOTIFICATIONS SECTION -->
      <div id="notifications-section" class="mt-4">
        <h2 style="font-size:1.1rem; font-weight:700; margin-bottom:16px;">
          <i class="ph ph-bell" style="color:var(--ds-primary);"></i> Recent Notifications
        </h2>
        <div class="ds-card">
          <div class="ds-card-body p-0">
            <div id="notif-section-list">
              <div class="ds-loading-overlay"><div class="ds-spinner"></div></div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <div class="ds-toast-container" id="toast-container"></div>
  <script>
    window.__INITIAL_PROGRAMS__ = {{{programsJson}}};
    console.debug('unit dashboard initial programs', window.__INITIAL_PROGRAMS__);
  </script>
  <script src="/javascripts/notifications.js"></script>
  <script src="/javascripts/unit-dashboard.js"></script>
</body>
</html>
