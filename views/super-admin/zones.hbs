<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zones | SYS Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/variables.css">
  <link rel="stylesheet" href="/stylesheets/dashboard.css?v=2">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#14533e">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<body class="dashboard-body">
  <div class="ds-sidebar-overlay" id="sidebar-overlay"></div>
  <aside class="ds-sidebar" id="sidebar">
    <div class="ds-sidebar-brand">
      <img src="/images/Gemini_Generated_Image_41luhh41luhh41lu-removebg-preview.png" alt="SYS" class="ds-sidebar-logo">
      <div>
        <div class="ds-sidebar-title">SYS Admin</div>
        <div class="ds-sidebar-subtitle">Kozhikode South</div>
      </div>
    </div>
    <nav class="ds-sidebar-nav">
      <div class="ds-nav-section-title">Overview</div>
      <a href="/super-admin" class="ds-nav-link"><i class="ph ph-squares-four"></i> Dashboard</a>
      <div class="ds-nav-section-title">Management</div>
      <a href="/super-admin/zones" class="ds-nav-link active"><i class="ph ph-map-pin"></i> Zones</a>
      <a href="/super-admin/circles" class="ds-nav-link"><i class="ph ph-circles-three"></i> Circles</a>
      <a href="/super-admin/users" class="ds-nav-link"><i class="ph ph-users"></i> Unit Users</a>
      <a href="/super-admin/programs" class="ds-nav-link"><i class="ph ph-clipboard-text"></i> Programs</a>
      <a href="/super-admin/profile" class="ds-nav-link"><i class="ph ph-gear"></i> Account Settings</a>
      <div class="ds-nav-section-title">Analytics</div>
      <a href="/super-admin/monthly-reports" class="ds-nav-link"><i class="ph ph-calendar-check"></i> Reports</a>
    </nav>
    <div class="ds-sidebar-footer">
      <div class="ds-user-widget">
        <div class="ds-user-avatar">SA</div>
        <div class="ds-user-info">
          <div class="ds-user-name">{{user.unitName}}</div>
          <div class="ds-user-role">Super Admin</div>
        </div>
        <a href="/logout" class="ds-logout-btn" title="Logout"><i class="ph ph-sign-out"></i></a>
      </div>
    </div>
  </aside>

  <div class="ds-main">
    <header class="ds-topbar">
      <button class="ds-topbar-menu-btn" id="sidebar-toggle"><i class="ph ph-list"></i></button>
      <div class="ds-topbar-title">Zones</div>
    </header>

    <main class="ds-content">
      <div class="ds-page-header">
        <h1>Zone Management</h1>
        <p>Create, edit, and manage zones within the system.</p>
      </div>

      <div class="ds-filter-bar">
        <button class="ds-btn ds-btn-primary ms-auto" id="add-zone-btn"><i class="ph ph-plus"></i> Add Zone</button>
      </div>

      <div class="ds-card">
        <div class="ds-card-header">
          <h3 class="ds-card-title"><i class="ph ph-map-pin"></i> Zones <span class="ds-badge ds-badge-primary ms-2" id="zone-count-badge">0</span></h3>
        </div>
        <div class="ds-card-body p-0">
          <div class="ds-table-wrapper">
            <table class="ds-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Zone Name</th>
                  <th>Code</th>
                  <th>Username</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="zones-table-body">
                <tr><td colspan="6"><div class="ds-loading-overlay"><div class="ds-spinner"></div></div></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Zone Modal -->
  <div class="ds-modal-backdrop" id="zone-modal">
    <div class="ds-modal" style="max-width:500px;">
      <div class="ds-modal-header">
        <h4 class="ds-modal-title" id="zone-modal-title">Add Zone</h4>
        <button class="ds-modal-close" id="zone-modal-close"><i class="ph ph-x"></i></button>
      </div>
      <div class="ds-modal-body">
        <div class="row g-3">
          <div class="col-12">
            <div class="ds-form-group">
              <label class="ds-form-label" for="zone-name">Zone Name <span class="text-danger">*</span></label>
              <input type="text" class="ds-form-control" id="zone-name" placeholder="e.g. Kozhikode North">
            </div>
          </div>
          <div class="col-12">
            <div class="ds-form-group">
              <label class="ds-form-label" for="zone-code">Zone Code</label>
              <input type="text" class="ds-form-control" id="zone-code" placeholder="e.g. Z01">
            </div>
          </div>
          <div class="col-12">
            <div class="ds-form-group">
              <label class="ds-form-label" for="zone-username">Username <span class="text-danger">*</span></label>
              <input type="text" class="ds-form-control" id="zone-username" placeholder="Login Username">
            </div>
          </div>
          <div class="col-12" id="zone-password-group">
            <div class="ds-form-group">
              <label class="ds-form-label" for="zone-password">Password <span class="text-danger" id="zone-pw-req">*</span></label>
              <input type="text" class="ds-form-control" id="zone-password" placeholder="Set password">
              <small class="text-muted" id="zone-pw-hint"></small>
            </div>
          </div>
          <div class="col-12">
            <div class="ds-form-group">
              <label class="ds-form-label" for="zone-status">Status</label>
              <select class="ds-form-control ds-form-select" id="zone-status">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
              </select>
            </div>
          </div>
        </div>
        <div id="zone-modal-error" class="text-danger small mt-2 d-none"></div>
      </div>
      <div class="ds-modal-footer">
        <button class="ds-btn ds-btn-outline" id="zone-modal-cancel">Cancel</button>
        <button class="ds-btn ds-btn-primary" id="zone-modal-save"><i class="ph ph-floppy-disk"></i> Save Zone</button>
      </div>
    </div>
  </div>

  <div class="ds-toast-container" id="toast-container"></div>
  <script src="/javascripts/pwa.js"></script>
  <script src="/javascripts/notifications.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      if (toggle) {
        toggle.addEventListener('click', () => {
          sidebar.classList.toggle('active');
          overlay.classList.toggle('active');
        });
      }
      if (overlay) {
        overlay.addEventListener('click', () => {
          sidebar.classList.remove('active');
          overlay.classList.remove('active');
        });
      }

      loadZones();
      
      const modal = document.getElementById('zone-modal');
      let editingId = null;

      document.getElementById('add-zone-btn').addEventListener('click', () => {
        editingId = null;
        document.getElementById('zone-modal-title').textContent = 'Add Zone';
        document.getElementById('zone-name').value = '';
        document.getElementById('zone-code').value = '';
        document.getElementById('zone-username').value = '';
        document.getElementById('zone-password').value = '';
        document.getElementById('zone-status').value = 'Active';
        document.getElementById('zone-pw-req').style.display = 'inline';
        document.getElementById('zone-pw-hint').textContent = '';
        document.getElementById('zone-modal-error').classList.add('d-none');
        modal.classList.add('open');
      });

      const closeModal = () => modal.classList.remove('open');
      document.getElementById('zone-modal-close').addEventListener('click', closeModal);
      document.getElementById('zone-modal-cancel').addEventListener('click', closeModal);

      document.getElementById('zone-modal-save').addEventListener('click', async () => {
        const name = document.getElementById('zone-name').value.trim();
        const code = document.getElementById('zone-code').value.trim();
        const username = document.getElementById('zone-username').value.trim();
        const password = document.getElementById('zone-password').value.trim();
        const status = document.getElementById('zone-status').value;
        const errEl = document.getElementById('zone-modal-error');
        
        if (!name || !username || (!editingId && !password)) {
          errEl.textContent = 'Name, username, and password are required.';
          errEl.classList.remove('d-none');
          return;
        }

        const btn = document.getElementById('zone-modal-save');
        btn.disabled = true;
        btn.innerHTML = '<div class="ds-spinner" style="width:1rem;height:1rem;"></div> Saving...';

        try {
          const url = editingId ? `/api/admin/zones/${editingId}` : '/api/admin/zones';
          const method = editingId ? 'PUT' : 'POST';
          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, code, username, password, status })
          });
          const data = await res.json();
          if (data.success) {
            closeModal();
            loadZones();
          } else {
            errEl.textContent = data.message || 'Error saving zone.';
            errEl.classList.remove('d-none');
          }
        } catch (err) {
          errEl.textContent = 'Network error.';
          errEl.classList.remove('d-none');
        } finally {
          btn.disabled = false;
          btn.innerHTML = '<i class="ph ph-floppy-disk"></i> Save Zone';
        }
      });

      async function loadZones() {
        const tbody = document.getElementById('zones-table-body');
        try {
          const res = await fetch('/api/admin/zones');
          const data = await res.json();
          if (data.success) {
            document.getElementById('zone-count-badge').textContent = data.zones.length;
            if (data.zones.length === 0) {
              tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">No zones found.</td></tr>';
              return;
            }
            tbody.innerHTML = data.zones.map((z, i) => `
              <tr>
                <td>${i + 1}</td>
                <td><strong>${z.name}</strong></td>
                <td>${z.code || '-'}</td>
                <td>${z.username || '-'}</td>
                <td><span class="ds-badge ${z.status === 'Active' ? 'ds-badge-success' : 'ds-badge-secondary'}">${z.status || 'Active'}</span></td>
                <td>
                  <div class="d-flex gap-2">
                    <button class="ds-btn ds-btn-outline ds-btn-sm edit-btn" data-id="${z._id}" data-name="${z.name}" data-code="${z.code||''}" data-username="${z.username||''}" data-status="${z.status||'Active'}">
                      <i class="ph ph-pencil-simple"></i> Edit
                    </button>
                    <button class="ds-btn ds-btn-outline ds-btn-sm text-danger delete-btn" data-id="${z._id}" data-name="${z.name}">
                      <i class="ph ph-trash"></i> Delete
                    </button>
                  </div>
                </td>
              </tr>
            `).join('');

            document.querySelectorAll('.edit-btn').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const tr = e.target.closest('button');
                editingId = tr.dataset.id;
                document.getElementById('zone-modal-title').textContent = 'Edit Zone';
                document.getElementById('zone-name').value = tr.dataset.name;
                document.getElementById('zone-code').value = tr.dataset.code;
                document.getElementById('zone-username').value = tr.dataset.username;
                document.getElementById('zone-password').value = '';
                document.getElementById('zone-status').value = tr.dataset.status;
                document.getElementById('zone-pw-req').style.display = 'none';
                document.getElementById('zone-pw-hint').textContent = 'Leave blank to keep current password.';
                document.getElementById('zone-modal-error').classList.add('d-none');
                modal.classList.add('open');
              });
            });

            document.querySelectorAll('.delete-btn').forEach(btn => {
              btn.addEventListener('click', async (e) => {
                const tr = e.target.closest('button');
                if (confirm(`Delete zone "${tr.dataset.name}"? This will also delete its circles.`)) {
                  try {
                    await fetch(`/api/admin/zones/${tr.dataset.id}`, { method: 'DELETE' });
                    loadZones();
                  } catch (err) { alert('Error deleting zone'); }
                }
              });
            });
          }
        } catch (err) {
          tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Failed to load zones.</td></tr>';
        }
      }
    });
  </script>
</body>
</html>
