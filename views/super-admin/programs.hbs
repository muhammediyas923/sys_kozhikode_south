<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Programs | SYS Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/variables.css">
  <link rel="stylesheet" href="/stylesheets/dashboard.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#14533e">
  <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>

<body class="dashboard-body">
  <div class="ds-sidebar-overlay" id="sidebar-overlay"></div>
  <aside class="ds-sidebar" id="sidebar">
    <div class="ds-sidebar-brand">
      <img src="/images/Gemini_Generated_Image_41luhh41luhh41lu-removebg-preview.png" alt="SYS" class="ds-sidebar-logo">
      <div>
        <div class="ds-sidebar-title">SYS Admin</div>
        <div class="ds-sidebar-subtitle">Kozhikode South</div>
      </div>
    </div>
    <nav class="ds-sidebar-nav">
      <div class="ds-nav-section-title">Overview</div>
      <a href="/super-admin" class="ds-nav-link"><i class="ph ph-squares-four"></i> Dashboard</a>
      <div class="ds-nav-section-title">Management</div>
      <a href="/super-admin/users" class="ds-nav-link"><i class="ph ph-users"></i> Unit Users</a>
      <a href="/super-admin/programs" class="ds-nav-link active"><i class="ph ph-clipboard-text"></i> Programs</a>
      <a href="/super-admin/profile" class="ds-nav-link"><i class="ph ph-gear"></i> Account Settings</a>
      <div class="ds-nav-section-title">Analytics</div>
      <a href="/super-admin/reports" class="ds-nav-link"><i class="ph ph-chart-bar"></i> Reports</a>
    </nav>
    <div class="ds-sidebar-footer">
      <div class="ds-user-widget">
        <div class="ds-user-avatar">SA</div>
        <div class="ds-user-info">
          <div class="ds-user-name">{{user.unitName}}</div>
          <div class="ds-user-role">Super Admin</div>
        </div>
        <a href="/logout" class="ds-logout-btn" title="Logout"><i class="ph ph-sign-out"></i></a>
      </div>
    </div>
  </aside>

  <div class="ds-main">
    <header class="ds-topbar">
      <button class="ds-topbar-menu-btn" id="sidebar-toggle"><i class="ph ph-list"></i></button>
      <div class="ds-topbar-title">Programs</div>
    </header>

    <main class="ds-content">
      <div class="ds-page-header">
        <h1>Program Management</h1>
        <p>Create, publish, and manage programs distributed to all SYS units.</p>
      </div>

      <div class="ds-card">
        <div class="ds-card-header">
          <h3 class="ds-card-title"><i class="ph ph-clipboard-text"></i> All Programs <span
              class="ds-badge ds-badge-primary ms-2" id="program-count-badge">0</span></h3>
          <button class="ds-btn ds-btn-primary" id="add-program-btn">
            <i class="ph ph-plus"></i> Create Program
          </button>
        </div>
        <div class="ds-card-body p-0">
          <div class="ds-table-wrapper">
            <table class="ds-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Title</th>
                  <th>Description</th>
                  <th>Target</th>
                  <th>Participants</th>
                  <th>Due Date</th>
                  <th>Attachments</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="programs-table-body">
                <tr>
                    <td colspan="10">
                    <div class="ds-loading-overlay">
                      <div class="ds-spinner"></div>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Program Modal -->
  <div class="ds-modal-backdrop" id="program-modal">
    <div class="ds-modal" style="max-width:700px;">
      <div class="ds-modal-header">
        <h4 class="ds-modal-title" id="program-modal-title">Create Program</h4>
        <button class="ds-modal-close" id="program-modal-close"><i class="ph ph-x"></i></button>
      </div>
      <div class="ds-modal-body">
        <form id="program-form" enctype="multipart/form-data">
          <div class="row g-3">
            <div class="col-12">
              <div class="ds-form-group">
                <label class="ds-form-label" for="prog-title">Program Title <span class="text-danger">*</span></label>
                <input type="text" class="ds-form-control" id="prog-title" name="title"
                  placeholder="Enter program title" maxlength="200">
              </div>
            </div>
            <div class="col-12">
              <div class="ds-form-group">
                <label class="ds-form-label" for="prog-desc">Description</label>
                <textarea class="ds-form-control" id="prog-desc" name="description" rows="4"
                  placeholder="Describe this program..." style="resize:vertical;"></textarea>
              </div>
            </div>
            <div class="col-md-6">
              <div class="ds-form-group">
                <label class="ds-form-label" for="prog-due">Due Date</label>
                <input type="date" class="ds-form-control" id="prog-due" name="dueDate">
              </div>
            </div>
            <div class="col-md-6">
              <div class="ds-form-group">
                <label class="ds-form-label" for="prog-required-count">
                  Target Count
                  <small class="text-muted" style="font-weight:400;"> (how many times users must complete this program)</small>
                </label>
                <input type="number" class="ds-form-control" id="prog-required-count" name="requiredCount" value="1"
                  min="1" max="999" placeholder="1">
              </div>
            </div>
            <div class="col-12">
              <div class="ds-form-group">
                <label class="ds-form-label">Attachments</label>
                <div class="ds-upload-zone" id="upload-zone">
                  <i class="ph ph-upload-simple"></i>
                  <p><strong>Click to upload</strong> or drag & drop files here</p>
                  <p style="font-size:0.75rem; color:#999; margin-top:4px;">PDF, Images, Word documents (max 10MB each)
                  </p>
                  <input type="file" id="file-input" name="attachments" multiple
                    accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,.doc,.docx" style="display:none;">
                </div>
                <div id="file-list" class="mt-2"></div>
              </div>
            </div>
          </div>
        </form>
        <div id="program-modal-error" class="text-danger small mt-2 d-none"></div>
      </div>
      <div class="ds-modal-footer">
        <button class="ds-btn ds-btn-outline" id="program-modal-cancel">Cancel</button>
        <button class="ds-btn ds-btn-primary" id="program-modal-save">
          <i class="ph ph-floppy-disk"></i> Save Program
        </button>
      </div>
    </div>
  </div>

  <!-- Delete Modal -->
  <div class="ds-modal-backdrop" id="delete-modal">
    <div class="ds-modal" style="max-width:400px;">
      <div class="ds-modal-header">
        <h4 class="ds-modal-title">Delete Program</h4>
        <button class="ds-modal-close" id="delete-modal-close"><i class="ph ph-x"></i></button>
      </div>
      <div class="ds-modal-body">
        <p>Delete <strong id="delete-prog-title"></strong>? All completion records for this program will also be
          removed.</p>
      </div>
      <div class="ds-modal-footer">
        <button class="ds-btn ds-btn-outline" id="delete-cancel">Cancel</button>
        <button class="ds-btn ds-btn-danger" id="delete-confirm"><i class="ph ph-trash"></i> Delete</button>
      </div>
    </div>
  </div>

  <div class="ds-toast-container" id="toast-container"></div>
  <script src="/javascripts/pwa.js"></script>
  <script src="/javascripts/notifications.js"></script>
  <script src="/javascripts/super-admin-programs.js?v=3"></script>

  <!-- Program Completions Detail Modal -->
  <div class="ds-modal-backdrop" id="completions-modal">
    <div class="ds-modal" style="max-width:860px; max-height:90vh; overflow-y:auto;">
      <div class="ds-modal-header" style="position:sticky; top:0; z-index:20; background:white;">
        <h4 class="ds-modal-title" id="completions-modal-title"><i class="ph ph-users"></i> Program Completions</h4>
        <button class="ds-modal-close" id="completions-modal-close"><i class="ph ph-x"></i></button>
      </div>
      <div class="ds-modal-body" id="completions-modal-body">
        <div class="ds-loading-overlay">
          <div class="ds-spinner"></div>
        </div>
      </div>
    </div>
  </div>
</body>

</html>