<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Settings | SYS Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/variables.css">
  <link rel="stylesheet" href="/stylesheets/dashboard.css?v=2">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#14533e">
  <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<body class="dashboard-body">
  <div class="ds-sidebar-overlay" id="sidebar-overlay"></div>
  <aside class="ds-sidebar" id="sidebar">
    <div class="ds-sidebar-brand">
      <img src="/images/Gemini_Generated_Image_41luhh41luhh41lu-removebg-preview.png" alt="SYS" class="ds-sidebar-logo">
      <div>
        <div class="ds-sidebar-title">SYS Admin</div>
        <div class="ds-sidebar-subtitle">Kozhikode South</div>
      </div>
    </div>
    <nav class="ds-sidebar-nav">
      <div class="ds-nav-section-title">Overview</div>
      <a href="/super-admin" class="ds-nav-link"><i class="ph ph-squares-four"></i> Dashboard</a>
      <div class="ds-nav-section-title">Management</div>
      <a href="/super-admin/zones" class="ds-nav-link"><i class="ph ph-map-pin"></i> Zones</a>
      <a href="/super-admin/circles" class="ds-nav-link"><i class="ph ph-circles-three"></i> Circles</a>
      <a href="/super-admin/users" class="ds-nav-link"><i class="ph ph-users"></i> Unit Users</a>
      <a href="/super-admin/programs" class="ds-nav-link"><i class="ph ph-clipboard-text"></i> Programs</a>
      <a href="/super-admin/profile" class="ds-nav-link active"><i class="ph ph-gear"></i> Account Settings</a>
      <div class="ds-nav-section-title">Analytics</div>
      <a href="/super-admin/reports" class="ds-nav-link"><i class="ph ph-chart-bar"></i> Reports</a>
    </nav>
    <div class="ds-sidebar-footer">
      <div class="ds-user-widget">
        <div class="ds-user-avatar">SA</div>
        <div class="ds-user-info">
          <div class="ds-user-name">{{user.unitName}}</div>
          <div class="ds-user-role">Super Admin</div>
        </div>
        <a href="/logout" class="ds-logout-btn" title="Logout"><i class="ph ph-sign-out"></i></a>
      </div>
    </div>
  </aside>

  <div class="ds-main">
    <header class="ds-topbar">
      <button type="button" class="ds-topbar-menu-btn" id="sidebar-toggle" aria-label="Toggle sidebar"><i class="ph ph-list"></i></button>
      <div class="ds-topbar-title">Account Settings</div>
    </header>

    <main class="ds-content">
      <div class="ds-page-header">
        <h1>Account Settings</h1>
        <p>Update your admin username and password securely from one place.</p>
      </div>

      <div class="row gy-4">
        <div class="col-lg-6">
          <div class="ds-card">
            <div class="ds-card-header">
              <h3 class="ds-card-title"><i class="ph ph-user-circle"></i> Username</h3>
            </div>
            <div class="ds-card-body">
              <div class="mb-3">
                <label class="ds-form-label">Current Username</label>
                <div class="d-flex align-items-center gap-3">
                  <div id="current-username" class="ds-text-muted fw-semibold">{{user.username}}</div>
                  <button class="ds-btn ds-btn-outline ds-btn-sm" id="edit-username-btn"><i class="ph ph-pencil-simple"></i> Edit</button>
                </div>
              </div>
              <form id="username-form" class="d-none" novalidate>
                <div class="mb-3">
                  <label class="ds-form-label" for="new-username">New Username</label>
                  <input type="text" class="ds-form-control" id="new-username" placeholder="Enter new username" autocomplete="username">
                </div>
                <div id="username-feedback" class="text-danger small d-none"></div>
                <div class="d-flex justify-content-end gap-2">
                  <button type="button" class="ds-btn ds-btn-outline" id="cancel-username-btn">Cancel</button>
                  <button type="submit" class="ds-btn ds-btn-primary" id="save-username-btn">Save</button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="ds-card">
            <div class="ds-card-header">
              <h3 class="ds-card-title"><i class="ph ph-key"></i> Change Password</h3>
            </div>
            <div class="ds-card-body">
              <form id="password-form" novalidate>
                <div class="mb-3">
                  <label class="ds-form-label" for="current-password">Current Password</label>
                  <input type="password" class="ds-form-control" id="current-password" placeholder="Enter current password" autocomplete="current-password">
                </div>
                <div class="mb-3">
                  <label class="ds-form-label" for="new-password">New Password</label>
                  <input type="password" class="ds-form-control" id="new-password" placeholder="Enter new password" autocomplete="new-password">
                </div>
                <div class="mb-3">
                  <label class="ds-form-label" for="confirm-password">Confirm New Password</label>
                  <input type="password" class="ds-form-control" id="confirm-password" placeholder="Confirm new password" autocomplete="new-password">
                </div>
                <div id="password-feedback" class="text-danger small d-none"></div>
                <div class="d-flex justify-content-end gap-2">
                  <button type="submit" class="ds-btn ds-btn-warning" id="change-password-btn">Change Password</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <div class="ds-toast-container" id="toast-container"></div>
  <script src="/javascripts/pwa.js"></script>
  <script src="/javascripts/notifications.js"></script>
  <script src="/javascripts/super-admin-profile.js"></script>
</body>
</html>
