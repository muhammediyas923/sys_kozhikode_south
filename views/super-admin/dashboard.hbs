<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | SYS Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/variables.css">
  <link rel="stylesheet" href="/stylesheets/dashboard.css?v=2">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#14533e">
  <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="dashboard-body">
  <div class="ds-sidebar-overlay" id="sidebar-overlay"></div>

  <!-- SIDEBAR -->
  <aside class="ds-sidebar" id="sidebar">
    <div class="ds-sidebar-brand">
      <img src="/images/Gemini_Generated_Image_41luhh41luhh41lu-removebg-preview.png" alt="SYS" class="ds-sidebar-logo">
      <div>
        <div class="ds-sidebar-title">SYS Admin</div>
        <div class="ds-sidebar-subtitle">Kozhikode South</div>
      </div>
    </div>

    <nav class="ds-sidebar-nav">
      <div class="ds-nav-section-title">Overview</div>
      <a href="/super-admin" class="ds-nav-link active">
        <i class="ph ph-squares-four"></i> Dashboard
      </a>

      <div class="ds-nav-section-title">Management</div>
      <a href="/super-admin/zones" class="ds-nav-link">
        <i class="ph ph-map-pin"></i> Zones
      </a>
      <a href="/super-admin/circles" class="ds-nav-link">
        <i class="ph ph-circles-three"></i> Circles
      </a>
      <a href="/super-admin/users" class="ds-nav-link">
        <i class="ph ph-users"></i> Unit Users
      </a>
      <a href="/super-admin/programs" class="ds-nav-link">
        <i class="ph ph-clipboard-text"></i> Programs
      </a>
      <a href="/super-admin/profile" class="ds-nav-link">
        <i class="ph ph-gear"></i> Account Settings
      </a>

      <div class="ds-nav-section-title">Analytics</div>
      <a href="/super-admin/monthly-reports" class="ds-nav-link">
        <i class="ph ph-calendar-check"></i> Reports
      </a>
    </nav>

    <div class="ds-sidebar-footer">
      <div class="ds-user-widget">
        <div class="ds-user-avatar">SA</div>
        <div class="ds-user-info">
          <div class="ds-user-name">{{user.unitName}}</div>
          <div class="ds-user-role">Super Admin</div>
        </div>
        <a href="/logout" class="ds-logout-btn" title="Logout">
          <i class="ph ph-sign-out"></i>
        </a>
      </div>
    </div>
  </aside>

  <!-- MAIN AREA -->
  <div class="ds-main">
    <!-- TOP BAR -->
    <header class="ds-topbar">
      <button type="button" class="ds-topbar-menu-btn" id="sidebar-toggle" aria-label="Toggle sidebar">
        <i class="ph ph-list"></i>
      </button>
      <div class="ds-topbar-title">Dashboard <span>/ Overview</span></div>
    </header>

    <!-- PAGE CONTENT -->
    <main class="ds-content">
      <div class="ds-page-header">
        <h1>Welcome back, {{user.unitName}} 👋</h1>
        <p>Here's what's happening across all 498 SYS Units today.</p>
      </div>

      <!-- STAT CARDS -->
      <div class="ds-stat-grid" id="stat-grid">
        <div class="ds-stat-card" style="--card-accent:#14533e; --card-icon-bg:#e8f5f0; --card-icon-color:#14533e;">
          <div class="ds-stat-icon"><i class="ph ph-map-pin"></i></div>
          <div class="ds-stat-value" id="stat-zones">—</div>
          <div class="ds-stat-label">Total Zones</div>
        </div>
        <div class="ds-stat-card" style="--card-accent:#0284c7; --card-icon-bg:#eff6ff; --card-icon-color:#0284c7;">
          <div class="ds-stat-icon"><i class="ph ph-circles-three"></i></div>
          <div class="ds-stat-value" id="stat-circles">—</div>
          <div class="ds-stat-label">Total Circles</div>
        </div>
        <div class="ds-stat-card" style="--card-accent:#7c3aed; --card-icon-bg:#f5f3ff; --card-icon-color:#7c3aed;">
          <div class="ds-stat-icon"><i class="ph ph-buildings"></i></div>
          <div class="ds-stat-value" id="stat-units">—</div>
          <div class="ds-stat-label">Total Units</div>
        </div>
        <div class="ds-stat-card" style="--card-accent:#16a34a; --card-icon-bg:#f0fdf4; --card-icon-color:#16a34a;">
          <div class="ds-stat-icon"><i class="ph ph-user-check"></i></div>
          <div class="ds-stat-value" id="stat-active">—</div>
          <div class="ds-stat-label">Active Users</div>
        </div>
        <div class="ds-stat-card" style="--card-accent:#e53e3e; --card-icon-bg:#fff5f5; --card-icon-color:#e53e3e;">
          <div class="ds-stat-icon"><i class="ph ph-user-minus"></i></div>
          <div class="ds-stat-value" id="stat-inactive">—</div>
          <div class="ds-stat-label">Inactive Users</div>
        </div>
        <div class="ds-stat-card" style="--card-accent:#f5a623; --card-icon-bg:#fef3d8; --card-icon-color:#d97706;">
          <div class="ds-stat-icon"><i class="ph ph-clipboard-text"></i></div>
          <div class="ds-stat-value" id="stat-programs">—</div>
          <div class="ds-stat-label">Total Programs</div>
        </div>
        <div class="ds-stat-card" style="--card-accent:#16a34a; --card-icon-bg:#f0fdf4; --card-icon-color:#16a34a;">
          <div class="ds-stat-icon"><i class="ph ph-check-circle"></i></div>
          <div class="ds-stat-value" id="stat-completed">—</div>
          <div class="ds-stat-label">Completions</div>
        </div>
        <div class="ds-stat-card" style="--card-accent:#0284c7; --card-icon-bg:#eff6ff; --card-icon-color:#0284c7;">
          <div class="ds-stat-icon"><i class="ph ph-percent"></i></div>
          <div class="ds-stat-value" id="stat-percent">—%</div>
          <div class="ds-stat-label">Completion Rate</div>
        </div>
      </div>

      <!-- CHARTS ROW -->
      <div class="row g-4 mb-4">
        <div class="col-lg-5">
          <div class="ds-card h-100">
            <div class="ds-card-header">
              <h3 class="ds-card-title"><i class="ph ph-chart-donut"></i> Completion Overview</h3>
            </div>
            <div class="ds-card-body" style="display:flex;align-items:center;justify-content:center;">
              <div class="ds-chart-container" style="height:260px;">
                <canvas id="doughnut-chart"></canvas>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-7">
          <div class="ds-card h-100">
            <div class="ds-card-header">
              <h3 class="ds-card-title"><i class="ph ph-chart-bar"></i> Zone-wise Completions</h3>
              <button class="ds-btn ds-btn-outline ds-btn-sm" id="refresh-btn">
                <i class="ph ph-arrows-clockwise"></i> Refresh
              </button>
            </div>
            <div class="ds-card-body">
              <div class="ds-chart-container" style="height:260px;">
                <canvas id="bar-chart"></canvas>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RECENT COMPLETIONS -->
      <div class="ds-card">
        <div class="ds-card-header">
          <h3 class="ds-card-title"><i class="ph ph-clock-countdown"></i> Recent Completions</h3>
          <a href="/super-admin/monthly-reports" class="ds-btn ds-btn-outline ds-btn-sm">View All Reports</a>
        </div>
        <div class="ds-card-body p-0">
          <div class="ds-table-wrapper">
            <table class="ds-table">
              <thead>
                <tr>
                  <th>Unit Name</th>
                  <th>Zone</th>
                  <th>Circle</th>
                  <th>Program</th>
                  <th>Notes</th>
                  <th>Completed On</th>
                </tr>
              </thead>
              <tbody id="recent-table">
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">Loading...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- TOAST CONTAINER -->
  <div class="ds-toast-container" id="toast-container"></div>

  <script src="/javascripts/pwa.js"></script>
  <script src="/javascripts/notifications.js"></script>
  <script src="/javascripts/super-admin-dashboard.js?v=5"></script>
</body>

</html>
