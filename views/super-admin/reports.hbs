<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports | SYS Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/variables.css">
  <link rel="stylesheet" href="/stylesheets/dashboard.css">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<body class="dashboard-body">
  <div class="ds-sidebar-overlay" id="sidebar-overlay"></div>
  <aside class="ds-sidebar" id="sidebar">
    <div class="ds-sidebar-brand">
      <img src="/images/Gemini_Generated_Image_41luhh41luhh41lu-removebg-preview.png" alt="SYS" class="ds-sidebar-logo">
      <div>
        <div class="ds-sidebar-title">SYS Admin</div>
        <div class="ds-sidebar-subtitle">Kozhikode South</div>
      </div>
    </div>
    <nav class="ds-sidebar-nav">
      <div class="ds-nav-section-title">Overview</div>
      <a href="/super-admin" class="ds-nav-link"><i class="ph ph-squares-four"></i> Dashboard</a>
      <div class="ds-nav-section-title">Management</div>
      <a href="/super-admin/users" class="ds-nav-link"><i class="ph ph-users"></i> Unit Users</a>
      <a href="/super-admin/programs" class="ds-nav-link"><i class="ph ph-clipboard-text"></i> Programs</a>
      <div class="ds-nav-section-title">Analytics</div>
      <a href="/super-admin/reports" class="ds-nav-link active"><i class="ph ph-chart-bar"></i> Reports</a>
    </nav>
    <div class="ds-sidebar-footer">
      <div class="ds-user-widget">
        <div class="ds-user-avatar">SA</div>
        <div class="ds-user-info">
          <div class="ds-user-name">{{user.unitName}}</div>
          <div class="ds-user-role">Super Admin</div>
        </div>
        <a href="/logout" class="ds-logout-btn" title="Logout"><i class="ph ph-sign-out"></i></a>
      </div>
    </div>
  </aside>

  <div class="ds-main">
    <header class="ds-topbar">
      <button class="ds-topbar-menu-btn" id="sidebar-toggle"><i class="ph ph-list"></i></button>
      <div class="ds-topbar-title">Reports</div>
    </header>

    <main class="ds-content">
      <div class="ds-page-header">
        <h1>Reports & Analytics</h1>
        <p>Filter, search and export program completion data across all units.</p>
      </div>

      <!-- Filter Panel -->
      <div class="ds-card mb-4">
        <div class="ds-card-header">
          <h3 class="ds-card-title"><i class="ph ph-funnel"></i> Filter Options</h3>
          <button class="ds-btn ds-btn-outline ds-btn-sm" id="clear-filters-btn">
            <i class="ph ph-x"></i> Clear
          </button>
        </div>
        <div class="ds-card-body">
          <div class="row g-3">
            <div class="col-md-3">
              <label class="ds-form-label">Zone</label>
              <select class="ds-form-control ds-form-select" id="rpt-zone">
                <option value="">All Zones</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="ds-form-label">Circle</label>
              <select class="ds-form-control ds-form-select" id="rpt-circle">
                <option value="">All Circles</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="ds-form-label">Unit Name</label>
              <input type="text" class="ds-form-control" id="rpt-unit" placeholder="Search unit...">
            </div>
            <div class="col-md-3">
              <label class="ds-form-label">Program</label>
              <select class="ds-form-control ds-form-select" id="rpt-program">
                <option value="">All Programs</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="ds-form-label">Status</label>
              <select class="ds-form-control ds-form-select" id="rpt-status">
                <option value="">All Status</option>
                <option value="completed">Completed</option>
                <option value="pending">Pending</option>
              </select>
            </div>
            <div class="col-md-9 d-flex align-items-end gap-2">
              <button class="ds-btn ds-btn-primary" id="run-report-btn">
                <i class="ph ph-magnifying-glass"></i> Run Report
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Results Table -->
      <div class="ds-card">
        <div class="ds-card-header">
          <h3 class="ds-card-title"><i class="ph ph-table"></i> Results <span class="ds-badge ds-badge-primary ms-2" id="result-count">0</span></h3>
          <div class="d-flex gap-2">
            <button class="ds-btn ds-btn-outline ds-btn-sm" id="print-btn"><i class="ph ph-printer"></i> Print</button>
            <button class="ds-btn ds-btn-outline ds-btn-sm" id="export-pdf-btn"><i class="ph ph-file-pdf"></i> PDF</button>
            <button class="ds-btn ds-btn-primary ds-btn-sm" id="export-excel-btn"><i class="ph ph-file-xls"></i> Excel</button>
          </div>
        </div>
        <div class="ds-card-body p-0">
          <div class="ds-table-wrapper">
            <table class="ds-table" id="report-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Zone</th>
                  <th>Circle</th>
                  <th>Unit Name</th>
                  <th>Username</th>
                  <th>Program</th>
                  <th>Status</th>
                  <th>Completed On</th>
                </tr>
              </thead>
              <tbody id="report-table-body">
                <tr>
                  <td colspan="8">
                    <div class="ds-empty">
                      <i class="ph ph-table ds-empty-icon"></i>
                      <h3>No results yet</h3>
                      <p>Apply filters above and click "Run Report" to see data.</p>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <div class="ds-toast-container" id="toast-container"></div>
  <script src="/javascripts/notifications.js"></script>
  <script src="/javascripts/super-admin-reports.js"></script>
</body>
</html>
