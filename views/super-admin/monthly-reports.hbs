  <!-- SCRIPT LOGIC -->
  <script>
    let globalReportsData = null;
    let currentGalleryImages = [];
    let currentLightboxIdx = 0;
    let zoomScale = 1;
    let activeUserTypeTab = 'UnitUser'; // 'UnitUser', 'CircleUser', 'ZoneUser'

    // Independent pagination & sorting states for each table
    const tableStates = {
      UnitUser: { currentPage: 1, pageSize: 10, sortField: 'lastUpdated', sortDir: 'desc' },
      CircleUser: { currentPage: 1, pageSize: 10, sortField: 'lastUpdated', sortDir: 'desc' },
      ZoneUser: { currentPage: 1, pageSize: 10, sortField: 'lastUpdated', sortDir: 'desc' }
    };

    // Chart instances
    let chartMonthly = null;
    let chartUserType = null;
    let chartZone = null;
    let chartCircle = null;

    document.addEventListener('DOMContentLoaded', () => {
      fetchReports();

      // Bind filter inputs
      const filterInputs = ['filter-month', 'filter-year', 'filter-zone', 'filter-circle', 'filter-unit', 'filter-program', 'filter-status'];
      filterInputs.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('change', () => fetchReports());
      });

      // Search debounced
      let searchTimeout;
      document.getElementById('filter-search').addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => fetchReports(), 300);
      });

      // Reset filters
      document.getElementById('reset-filters-btn').addEventListener('click', () => {
        document.getElementById('filter-month').value = 'all';
        document.getElementById('filter-year').value = 'all';
        document.getElementById('filter-zone').value = 'all';
        document.getElementById('filter-circle').value = 'all';
        document.getElementById('filter-unit').value = '';
        document.getElementById('filter-program').value = 'all';
        document.getElementById('filter-status').value = 'all';
        document.getElementById('filter-search').value = '';
        fetchReports();
      });

      // Tab switching listener to sync activeUserTypeTab and filter visibility
      const unitTabEl = document.getElementById('unit-tab');
      const circleTabEl = document.getElementById('circle-tab');
      const zoneTabEl = document.getElementById('zone-tab');

      if (unitTabEl) unitTabEl.addEventListener('shown.bs.tab', () => setActiveUserTypeTab('UnitUser'));
      if (circleTabEl) circleTabEl.addEventListener('shown.bs.tab', () => setActiveUserTypeTab('CircleUser'));
      if (zoneTabEl) zoneTabEl.addEventListener('shown.bs.tab', () => setActiveUserTypeTab('ZoneUser'));

      // Export Buttons
      document.getElementById('export-excel-btn').addEventListener('click', (e) => { e.preventDefault(); triggerExport('excel'); });
      document.getElementById('export-pdf-btn').addEventListener('click', (e) => { e.preventDefault(); triggerExport('pdf'); });
      document.getElementById('export-csv-btn').addEventListener('click', (e) => { e.preventDefault(); triggerExport('csv'); });

      // Lightbox Controls
      document.getElementById('lb-prev-btn').addEventListener('click', () => navigateLightbox(-1));
      document.getElementById('lb-next-btn').addEventListener('click', () => navigateLightbox(1));
      document.getElementById('lb-zoom-in').addEventListener('click', () => adjustZoom(0.2));
      document.getElementById('lb-zoom-out').addEventListener('click', () => adjustZoom(-0.2));
      document.getElementById('lb-zoom-reset').addEventListener('click', () => resetZoom());
    });

    function setActiveUserTypeTab(userType) {
      activeUserTypeTab = userType;
      const heading = document.getElementById('filter-heading-text');
      const circleCol = document.getElementById('filter-circle-col');
      const unitCol = document.getElementById('filter-unit-col');

      if (userType === 'UnitUser') {
        if (heading) heading.innerText = 'Filter Unit User Progress';
        if (circleCol) circleCol.style.display = 'block';
        if (unitCol) unitCol.style.display = 'block';
      } else if (userType === 'CircleUser') {
        if (heading) heading.innerText = 'Filter Circle User Progress';
        if (circleCol) circleCol.style.display = 'block';
        if (unitCol) unitCol.style.display = 'none';
      } else if (userType === 'ZoneUser') {
        if (heading) heading.innerText = 'Filter Zone User Progress';
        if (circleCol) circleCol.style.display = 'none';
        if (unitCol) unitCol.style.display = 'none';
      }
    }

    function getFilterParams() {
      const p = new URLSearchParams();
      const m = document.getElementById('filter-month').value;
      const y = document.getElementById('filter-year').value;
      const z = document.getElementById('filter-zone').value;
      const c = document.getElementById('filter-circle').value;
      const u = document.getElementById('filter-unit').value.trim();
      const prog = document.getElementById('filter-program').value;
      const st = document.getElementById('filter-status').value;
      const sr = document.getElementById('filter-search').value.trim();

      if (m !== 'all') p.append('month', m);
      if (y !== 'all') p.append('year', y);
      if (z !== 'all') p.append('zone', z);
      if (c !== 'all' && activeUserTypeTab !== 'ZoneUser') p.append('circle', c);
      if (u && activeUserTypeTab === 'UnitUser') p.append('unit', u);
      if (prog !== 'all') p.append('program', prog);
      if (st !== 'all') p.append('status', st);
      if (sr) p.append('search', sr);
      return p;
    }

    async function fetchReports() {
      try {
        const params = getFilterParams();
        const res = await fetch(`/api/admin/monthly-reports?${params.toString()}`);
        const data = await res.json();
        if (!data.success) return;

        globalReportsData = data;

        // Populate dropdowns once
        populateFilterDropdowns(data.options);

        // Update top summary cards
        document.getElementById('card-total-programs').innerText = data.summary.totalPrograms;
        document.getElementById('card-completed-programs').innerText = data.summary.completedPrograms;
        document.getElementById('card-pending-programs').innerText = data.summary.pendingPrograms;
        document.getElementById('card-total-participants').innerText = data.summary.totalParticipants;
        document.getElementById('card-total-images').innerText = data.summary.totalImagesUploaded;
        document.getElementById('card-this-month').innerText = data.summary.thisMonthCompletions;

        // Update tab count badges
        const unitList = data.unitCompletions || [];
        const circleList = data.circleCompletions || [];
        const zoneList = data.zoneCompletions || [];

        document.getElementById('unit-count-badge').innerText = unitList.length;
        document.getElementById('circle-count-badge').innerText = circleList.length;
        document.getElementById('zone-count-badge').innerText = zoneList.length;

        document.getElementById('unit-info-badge').innerText = `${unitList.length} records`;
        document.getElementById('circle-info-badge').innerText = `${circleList.length} records`;
        document.getElementById('zone-info-badge').innerText = `${zoneList.length} records`;

        // Render the 3 separate progress tables independently
        renderUserProgressTable('UnitUser', unitList, 'unit-table-body');
        renderUserProgressTable('CircleUser', circleList, 'circle-table-body');
        renderUserProgressTable('ZoneUser', zoneList, 'zone-table-body');

        // Render Gallery & Analytics
        renderGlobalGallery(data.gallery);
        renderAnalyticsCharts(data.analytics);

      } catch (err) {
        console.error('Failed to fetch reports:', err);
      }
    }

    function populateFilterDropdowns(options) {
      if (!options) return;
      const zoneSel = document.getElementById('filter-zone');
      if (zoneSel && zoneSel.options.length <= 1 && options.zones) {
        options.zones.forEach(z => {
          const opt = document.createElement('option');
          opt.value = z; opt.textContent = z;
          zoneSel.appendChild(opt);
        });
      }

      const circleSel = document.getElementById('filter-circle');
      if (circleSel && circleSel.options.length <= 1 && options.circles) {
        options.circles.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c.name; opt.textContent = c.name;
          circleSel.appendChild(opt);
        });
      }

      const progSel = document.getElementById('filter-program');
      if (progSel && progSel.options.length <= 1 && options.programs) {
        options.programs.forEach(p => {
          const opt = document.createElement('option');
          opt.value = p.id; opt.textContent = p.title;
          progSel.appendChild(opt);
        });
      }

      const yearSel = document.getElementById('filter-year');
      if (yearSel && yearSel.options.length <= 1 && options.years) {
        options.years.forEach(y => {
          const opt = document.createElement('option');
          opt.value = y; opt.textContent = y;
          yearSel.appendChild(opt);
        });
      }
    }

    function sortTable(type, field) {
      const state = tableStates[type];
      if (state.sortField === field) {
        state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        state.sortField = field;
        state.sortDir = 'asc';
      }
      if (!globalReportsData) return;
      const keyMap = { UnitUser: 'unitCompletions', CircleUser: 'circleCompletions', ZoneUser: 'zoneCompletions' };
      const list = globalReportsData[keyMap[type]] || [];
      renderUserProgressTable(type, list, type === 'UnitUser' ? 'unit-table-body' : (type === 'CircleUser' ? 'circle-table-body' : 'zone-table-body'));
    }

    function changePageSize(type, val) {
      tableStates[type].pageSize = parseInt(val, 10);
      tableStates[type].currentPage = 1;
      if (!globalReportsData) return;
      const keyMap = { UnitUser: 'unitCompletions', CircleUser: 'circleCompletions', ZoneUser: 'zoneCompletions' };
      const list = globalReportsData[keyMap[type]] || [];
      renderUserProgressTable(type, list, type === 'UnitUser' ? 'unit-table-body' : (type === 'CircleUser' ? 'circle-table-body' : 'zone-table-body'));
    }

    function goToPage(type, pageNum) {
      tableStates[type].currentPage = pageNum;
      if (!globalReportsData) return;
      const keyMap = { UnitUser: 'unitCompletions', CircleUser: 'circleCompletions', ZoneUser: 'zoneCompletions' };
      const list = globalReportsData[keyMap[type]] || [];
      renderUserProgressTable(type, list, type === 'UnitUser' ? 'unit-table-body' : (type === 'CircleUser' ? 'circle-table-body' : 'zone-table-body'));
    }

    function renderUserProgressTable(type, rawItems, tbodyId) {
      const tbody = document.getElementById(tbodyId);
      const state = tableStates[type];

      const colCount = type === 'UnitUser' ? 8 : (type === 'CircleUser' ? 7 : 6);

      if (!rawItems || rawItems.length === 0) {
        tbody.innerHTML = `<tr><td colspan="${colCount}" class="text-center py-4 text-muted">No progress records found for this user type.</td></tr>`;
        updatePaginationUI(type, 0, 0, 0);
        return;
      }

      // Sort items
      const items = [...rawItems].sort((a, b) => {
        let valA = a[state.sortField];
        let valB = b[state.sortField];
        if (typeof valA === 'string') valA = valA.toLowerCase();
        if (typeof valB === 'string') valB = valB.toLowerCase();
        if (valA < valB) return state.sortDir === 'asc' ? -1 : 1;
        if (valA > valB) return state.sortDir === 'asc' ? 1 : -1;
        return 0;
      });

      // Pagination slice
      const total = items.length;
      const totalPages = Math.ceil(total / state.pageSize) || 1;
      if (state.currentPage > totalPages) state.currentPage = totalPages;

      const startIdx = (state.currentPage - 1) * state.pageSize;
      const endIdx = Math.min(startIdx + state.pageSize, total);
      const pageItems = items.slice(startIdx, endIdx);

      let html = '';
      pageItems.forEach(item => {
        const isComp = Boolean(item.completed);
        const statusBadge = isComp
          ? `<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="ph ph-check-circle me-1"></i>Completed</span>`
          : `<span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1"><i class="ph ph-clock me-1"></i>Pending</span>`;

        const lastUpdDate = item.lastUpdated ? new Date(item.lastUpdated).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';

        if (type === 'UnitUser') {
          html += `
            <tr>
              <td class="fw-bold text-dark">${escapeHtml(item.programTitle)}</td>
              <td>${escapeHtml(item.zone || '-')}</td>
              <td>${escapeHtml(item.circle || '-')}</td>
              <td><span class="fw-semibold text-primary">${escapeHtml(item.unit || item.completedBy || '-')}</span></td>
              <td><code class="text-primary">${escapeHtml(item.username)}</code></td>
              <td>${statusBadge}</td>
              <td class="small text-muted">${lastUpdDate}</td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-success rounded-pill px-3 d-inline-flex align-items-center gap-1" onclick="openDetailsModal('${item._id}')">
                  <i class="ph ph-eye"></i> View Details
                </button>
              </td>
            </tr>
          `;
        } else if (type === 'CircleUser') {
          html += `
            <tr>
              <td class="fw-bold text-dark">${escapeHtml(item.programTitle)}</td>
              <td>${escapeHtml(item.zone || '-')}</td>
              <td><span class="fw-semibold text-warning">${escapeHtml(item.circle || item.completedBy || '-')}</span></td>
              <td><code class="text-primary">${escapeHtml(item.username)}</code></td>
              <td>${statusBadge}</td>
              <td class="small text-muted">${lastUpdDate}</td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-success rounded-pill px-3 d-inline-flex align-items-center gap-1" onclick="openDetailsModal('${item._id}')">
                  <i class="ph ph-eye"></i> View Details
                </button>
              </td>
            </tr>
          `;
        } else if (type === 'ZoneUser') {
          html += `
            <tr>
              <td class="fw-bold text-dark">${escapeHtml(item.programTitle)}</td>
              <td><span class="fw-semibold text-purple" style="color:#6b21a8;">${escapeHtml(item.zone || item.completedBy || '-')}</span></td>
              <td><code class="text-primary">${escapeHtml(item.username)}</code></td>
              <td>${statusBadge}</td>
              <td class="small text-muted">${lastUpdDate}</td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-success rounded-pill px-3 d-inline-flex align-items-center gap-1" onclick="openDetailsModal('${item._id}')">
                  <i class="ph ph-eye"></i> View Details
                </button>
              </td>
            </tr>
          `;
        }
      });

      tbody.innerHTML = html;
      updatePaginationUI(type, startIdx + 1, endIdx, total);
    }

    function updatePaginationUI(type, start, end, total) {
      const typeLower = type.toLowerCase().replace('user', '');
      const infoEl = document.getElementById(`${typeLower}-pagination-info`);
      const pagEl = document.getElementById(`${typeLower}-pagination`);
      const state = tableStates[type];

      if (infoEl) infoEl.innerText = `Showing ${total === 0 ? 0 : start} to ${end} of ${total} entries`;
      if (!pagEl) return;

      const totalPages = Math.ceil(total / state.pageSize) || 1;
      let pagHtml = '';

      pagHtml += `<li class="page-item ${state.currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="#" onclick="event.preventDefault(); goToPage('${type}', ${state.currentPage - 1})">Prev</a></li>`;

      for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || (i >= state.currentPage - 1 && i <= state.currentPage + 1)) {
          pagHtml += `<li class="page-item ${i === state.currentPage ? 'active' : ''}"><a class="page-link" href="#" onclick="event.preventDefault(); goToPage('${type}', ${i})">${i}</a></li>`;
        } else if (i === state.currentPage - 2 || i === state.currentPage + 2) {
          pagHtml += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
        }
      }

      pagHtml += `<li class="page-item ${state.currentPage === totalPages || total === 0 ? 'disabled' : ''}"><a class="page-link" href="#" onclick="event.preventDefault(); goToPage('${type}', ${state.currentPage + 1})">Next</a></li>`;
      pagEl.innerHTML = pagHtml;
    }

    function openDetailsModal(id) {
      if (!globalReportsData) return;
      const item = globalReportsData.completions.find(c => c._id === id);
      if (!item) return;

      document.getElementById('modal-program-title').innerText = item.programTitle;
      document.getElementById('modal-status-badge').innerText = item.completed ? 'Completed' : 'Pending';
      document.getElementById('modal-status-badge').className = item.completed ? 'badge bg-success px-3 py-2 fs-6' : 'badge bg-warning text-dark px-3 py-2 fs-6';

      document.getElementById('modal-prog-desc').innerText = item.programDescription || 'No description available.';
      document.getElementById('modal-due-date').innerText = item.dueDate ? new Date(item.dueDate).toLocaleDateString() : 'N/A';
      document.getElementById('modal-target').innerText = item.requiredCount;
      document.getElementById('modal-actual').innerText = item.completionCount;

      document.getElementById('modal-user-name').innerText = item.completedBy;
      document.getElementById('modal-username').innerText = item.username;
      document.getElementById('modal-usertype-badge').innerText = item.userType;

      // Adapt User Info card rows based on User Type
      const isCircle = item.userType.includes('Circle');
      const isZone = item.userType.includes('Zone');

      document.getElementById('modal-zone-row').style.display = 'block';
      document.getElementById('modal-zone').innerText = item.zone || 'N/A';

      if (isZone) {
        document.getElementById('modal-circle-row').style.display = 'none';
        document.getElementById('modal-unit-row').style.display = 'none';
      } else if (isCircle) {
        document.getElementById('modal-circle-row').style.display = 'block';
        document.getElementById('modal-circle').innerText = item.circle || 'N/A';
        document.getElementById('modal-unit-row').style.display = 'none';
      } else {
        document.getElementById('modal-circle-row').style.display = 'block';
        document.getElementById('modal-circle').innerText = item.circle || 'N/A';
        document.getElementById('modal-unit-row').style.display = 'block';
        document.getElementById('modal-unit').innerText = item.unit || 'N/A';
      }

      document.getElementById('modal-participants-count').innerText = item.participantsCount;
      document.getElementById('modal-comp-date').innerText = item.completionDate ? new Date(item.completionDate).toLocaleDateString() : '-';
      document.getElementById('modal-photos-count').innerText = item.imagesCount;
      document.getElementById('modal-notes').innerText = item.notes || 'No remarks submitted.';

      // Timeline
      const tContainer = document.getElementById('modal-timeline-container');
      if (!item.timeline || item.timeline.length === 0) {
        tContainer.innerHTML = '<div class="text-muted small">No timeline events recorded.</div>';
      } else {
        let tHtml = '';
        item.timeline.forEach(t => {
          const tTime = t.timestamp ? new Date(t.timestamp).toLocaleString() : '';
          tHtml += `
            <div class="timeline-item">
              <div class="timeline-badge"><i class="ph ph-check"></i></div>
              <div class="timeline-content">
                <div class="timeline-title">${escapeHtml(t.title)}</div>
                <div class="timeline-time">${tTime}</div>
                <div class="small text-muted mt-1">${escapeHtml(t.description)}</div>
              </div>
            </div>
          `;
        });
        tContainer.innerHTML = tHtml;
      }

      // Modal Images Grid
      const mGrid = document.getElementById('modal-images-grid');
      if (!item.images || item.images.length === 0) {
        mGrid.innerHTML = '<div class="text-muted small">No evidence photos attached.</div>';
      } else {
        let gHtml = '';
        item.images.forEach((img, idx) => {
          gHtml += `
            <div class="gallery-card" onclick="openLightboxForImages(${JSON.stringify(item.images).replace(/"/g, '&quot;')}, ${idx})">
              <div class="gallery-img-wrapper">
                <img src="${img.url}" alt="${img.filename}" onerror="this.src='https://via.placeholder.com/300x200?text=Image+Unavailable'">
              </div>
              <div class="gallery-card-body">
                <div class="uploader-name">${escapeHtml(img.uploadedBy)}</div>
                <div class="uploader-meta">${img.uploadDate} at ${img.uploadTime}</div>
              </div>
            </div>
          `;
        });
        mGrid.innerHTML = gHtml;
      }

      const modalElem = new bootstrap.Modal(document.getElementById('detailsModal'));
      modalElem.show();
    }

    function renderGlobalGallery(galleryItems) {
      currentGalleryImages = galleryItems || [];
      document.getElementById('gallery-count-badge').innerText = currentGalleryImages.length;
      document.getElementById('gallery-total-info').innerText = `Showing ${currentGalleryImages.length} uploaded photo(s)`;

      const container = document.getElementById('gallery-grid-container');
      if (!currentGalleryImages || currentGalleryImages.length === 0) {
        container.innerHTML = '<div class="text-muted py-4">No uploaded images matching current filter criteria.</div>';
        return;
      }

      let html = '';
      currentGalleryImages.forEach((img, idx) => {
        html += `
          <div class="gallery-card" onclick="openLightboxForImages(currentGalleryImages, ${idx})">
            <div class="gallery-img-wrapper">
              <img src="${img.url}" alt="${img.filename}" onerror="this.src='https://via.placeholder.com/300x200?text=Photo'">
            </div>
            <div class="gallery-card-body">
              <div class="uploader-name">${escapeHtml(img.uploadedBy)}</div>
              <div class="uploader-meta">
                <div><code class="text-primary">${escapeHtml(img.username)}</code> (${escapeHtml(img.userType)})</div>
                <div>${escapeHtml(img.zone)} / ${escapeHtml(img.circle)}</div>
                <div class="fw-semibold text-dark mt-1">${escapeHtml(img.programTitle)}</div>
                <div class="text-muted mt-1" style="font-size:0.7rem;">${img.uploadDate} ${img.uploadTime}</div>
              </div>
            </div>
          </div>
        `;
      });
      container.innerHTML = html;
    }

    function openLightboxForImages(imagesList, index) {
      currentGalleryImages = imagesList;
      currentLightboxIdx = index;
      resetZoom();
      updateLightboxContent();
      const lbModal = new bootstrap.Modal(document.getElementById('lightboxModal'));
      lbModal.show();
    }

    function updateLightboxContent() {
      if (!currentGalleryImages || currentGalleryImages.length === 0) return;
      const img = currentGalleryImages[currentLightboxIdx];

      document.getElementById('lb-main-img').src = img.url;
      document.getElementById('lb-image-counter').innerText = `Image ${currentLightboxIdx + 1} of ${currentGalleryImages.length}`;

      document.getElementById('lb-uploader-name').innerText = img.uploadedBy || 'User';
      document.getElementById('lb-username').innerText = img.username || '-';
      document.getElementById('lb-user-type').innerText = img.userType || 'Unit User';
      document.getElementById('lb-location').innerText = `${img.zone || '-'} / ${img.circle || '-'} / ${img.unit || '-'}`;
      document.getElementById('lb-program-name').innerText = img.programTitle || 'Program';
      document.getElementById('lb-upload-timestamp').innerText = `${img.uploadDate || ''} at ${img.uploadTime || ''}`;
    }

    function navigateLightbox(dir) {
      if (!currentGalleryImages || currentGalleryImages.length === 0) return;
      currentLightboxIdx = (currentLightboxIdx + dir + currentGalleryImages.length) % currentGalleryImages.length;
      resetZoom();
      updateLightboxContent();
    }

    function adjustZoom(delta) {
      zoomScale = Math.max(0.5, Math.min(3, zoomScale + delta));
      document.getElementById('lb-main-img').style.transform = `scale(${zoomScale})`;
    }

    function resetZoom() {
      zoomScale = 1;
      const img = document.getElementById('lb-main-img');
      if (img) img.style.transform = 'scale(1)';
    }

    function renderAnalyticsCharts(analytics) {
      if (!analytics) return;

      // 1. Monthly Trends Chart
      const ctxM = document.getElementById('monthlyTrendChart').getContext('2d');
      if (chartMonthly) chartMonthly.destroy();
      chartMonthly = new Chart(ctxM, {
        type: 'bar',
        data: {
          labels: analytics.monthlyTrends.map(m => m.month),
          datasets: [
            { label: 'Completed Programs', data: analytics.monthlyTrends.map(m => m.completed), backgroundColor: '#14533e', borderRadius: 6 },
            { label: 'Participants', data: analytics.monthlyTrends.map(m => m.participants), backgroundColor: '#0284c7', borderRadius: 6, yAxisID: 'y1', type: 'line' }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { beginAtZero: true, title: { display: true, text: 'Completions' } },
            y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'Participants' } }
          }
        }
      });

      // 2. User Type Chart
      const ctxU = document.getElementById('userTypeChart').getContext('2d');
      if (chartUserType) chartUserType.destroy();
      chartUserType = new Chart(ctxU, {
        type: 'doughnut',
        data: {
          labels: analytics.userTypeAnalytics.map(u => u.type),
          datasets: [{
            data: analytics.userTypeAnalytics.map(u => u.count),
            backgroundColor: ['#0369a1', '#b45309', '#6b21a8', '#14533e']
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });

      // 3. Zone Chart
      const ctxZ = document.getElementById('zoneChart').getContext('2d');
      if (chartZone) chartZone.destroy();
      chartZone = new Chart(ctxZ, {
        type: 'bar',
        data: {
          labels: analytics.zoneAnalytics.map(z => z.zone),
          datasets: [{
            label: 'Completed Programs',
            data: analytics.zoneAnalytics.map(z => z.completed),
            backgroundColor: '#16a34a',
            borderRadius: 6
          }]
        },
        options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y' }
      });

      // 4. Circle Chart
      const ctxC = document.getElementById('circleChart').getContext('2d');
      if (chartCircle) chartCircle.destroy();
      chartCircle = new Chart(ctxC, {
        type: 'bar',
        data: {
          labels: analytics.circleAnalytics.map(c => c.circle),
          datasets: [{
            label: 'Completed Programs',
            data: analytics.circleAnalytics.map(c => c.completed),
            backgroundColor: '#d97706',
            borderRadius: 6
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    }

    function triggerExport(type) {
      const params = getFilterParams();
      if (activeUserTypeTab) {
        params.set('userType', activeUserTypeTab);
        params.set('userRole', activeUserTypeTab);
      }
      window.location.href = `/api/admin/monthly-reports/export/${type}?${params.toString()}`;
    }

    function escapeHtml(str) {
      return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // Mobile Sidebar Toggle
    (function () {
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebar-overlay');
      const tb = document.getElementById('sidebar-toggle');
      let _toggleBusy = false;
      window.toggleSidebar = function (e) {
        if (e && e.preventDefault) e.preventDefault();
        if (_toggleBusy) return;
        _toggleBusy = true;
        setTimeout(() => { _toggleBusy = false; }, 150);
        if (!sb || !ov) return;
        sb.classList.toggle('open');
        ov.classList.toggle('open');
      };
      tb?.addEventListener('click', window.toggleSidebar);
      ov?.addEventListener('click', function () {
        sb?.classList.remove('open');
        ov?.classList.remove('open');
      });
      // Auto-close sidebar when clicking links on mobile
      if (sb) {
        sb.querySelectorAll('.ds-nav-link').forEach(link => {
          link.addEventListener('click', () => {
            if (window.innerWidth <= 991) {
              sb.classList.remove('open');
              ov?.classList.remove('open');
            }
          });
        });
      }
    })();
  </script>
</body>

</html>