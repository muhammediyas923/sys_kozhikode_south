<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Login | SYS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/variables.css">
  <link rel="stylesheet" href="/stylesheets/main.css">
  <link rel="stylesheet" href="/stylesheets/components.css">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <style>
    body {
      background: linear-gradient(135deg, #0a2e1f 0%, #14533e 50%, #1a6b4f 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Inter', sans-serif;
    }
    .selection-card {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.4);
      border-radius: 24px;
      padding: 40px;
      width: 100%;
      max-width: 500px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
      text-align: center;
    }
    .selection-logo {
      height: 80px;
      margin-bottom: 24px;
    }
    .selection-title {
      font-weight: 700;
      color: var(--ds-text);
      margin-bottom: 8px;
    }
    .selection-subtitle {
      color: var(--ds-text-muted);
      margin-bottom: 32px;
      font-size: 1rem;
    }
    .selection-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 16px 24px;
      margin-bottom: 16px;
      border-radius: 16px;
      border: 2px solid transparent;
      background: white;
      color: var(--ds-text);
      font-weight: 600;
      font-size: 1.1rem;
      text-decoration: none;
      box-shadow: 0 4px 6px rgba(0,0,0,0.02);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .selection-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(0,0,0,0.05);
    }
    .btn-unit {
      border-color: #e2e8f0;
    }
    .btn-unit:hover {
      border-color: #14533e;
      background: #e8f5e9;
      color: #14533e;
    }
    .btn-circle {
      border-color: #e2e8f0;
    }
    .btn-circle:hover {
      border-color: #1a6b4f;
      background: #eafaf1;
      color: #1a6b4f;
    }
    .btn-zone {
      border-color: #e2e8f0;
    }
    .btn-zone:hover {
      border-color: #0a2e1f;
      background: #e0f2ec;
      color: #0a2e1f;
    }
    .icon-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 12px;
      font-size: 1.5rem;
    }
    .btn-unit .icon-wrapper { background: #e8f5e9; color: #14533e; }
    .btn-circle .icon-wrapper { background: #eafaf1; color: #1a6b4f; }
    .btn-zone .icon-wrapper { background: #e0f2ec; color: #0a2e1f; }
  </style>
</head>
<body>
  <div class="selection-card">
    <img src="/images/Gemini_Generated_Image_41luhh41luhh41lu-removebg-preview.png" alt="SYS Logo" class="selection-logo">
    <h2 class="selection-title">Welcome to SYS</h2>
    <p class="selection-subtitle">Select your login portal to continue</p>

    <a href="/login" class="selection-btn btn-unit">
      <div style="display:flex; align-items:center; gap:16px;">
        <div class="icon-wrapper"><i class="ph ph-buildings"></i></div>
        <span>Login as Unit User</span>
      </div>
      <i class="ph ph-caret-right text-muted"></i>
    </a>

    <a href="/circle-login" class="selection-btn btn-circle">
      <div style="display:flex; align-items:center; gap:16px;">
        <div class="icon-wrapper"><i class="ph ph-circles-three"></i></div>
        <span>Login as Circle User</span>
      </div>
      <i class="ph ph-caret-right text-muted"></i>
    </a>

    <a href="/zone-login" class="selection-btn btn-zone">
      <div style="display:flex; align-items:center; gap:16px;">
        <div class="icon-wrapper"><i class="ph ph-map-pin"></i></div>
        <span>Login as Zone User</span>
      </div>
      <i class="ph ph-caret-right text-muted"></i>
    </a>
    
    <div style="margin-top:24px; font-size:0.85rem;">
      <a href="/" style="color:var(--ds-text-muted); text-decoration:none;"><i class="ph ph-arrow-left"></i> Back to Home</a>
    </div>
  </div>
</body>
</html>
