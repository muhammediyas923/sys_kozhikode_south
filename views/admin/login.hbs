<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | SYS Kozhikode South</title>
  <meta name="description" content="Secure administration access for SYS Kozhikode South.">
  <meta name="robots" content="noindex, nofollow">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/variables.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#14533e">
  <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html {
      width: 100%;
      height: 100%;
      overflow-x: hidden;
      -webkit-text-size-adjust: 100%;
    }
    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      min-height: 100dvh;
      width: 100%;
      margin: 0;
      background: linear-gradient(135deg, #0a2e1f 0%, #0f3d2e 50%, #14533e 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.25rem 1rem;
      position: relative;
      overflow-x: hidden;
    }
    body::before {
      content: '';
      position: fixed;
      width: min(500px, 90vw);
      height: min(500px, 90vw);
      background: radial-gradient(circle, rgba(255,255,255,0.04) 0%, transparent 70%);
      top: -150px;
      right: -100px;
      border-radius: 50%;
      pointer-events: none;
      z-index: 0;
    }
    body::after {
      content: '';
      position: fixed;
      width: min(350px, 80vw);
      height: min(350px, 80vw);
      background: radial-gradient(circle, rgba(245,176,65,0.05) 0%, transparent 70%);
      bottom: -100px;
      left: -80px;
      border-radius: 50%;
      pointer-events: none;
      z-index: 0;
    }
    .login-wrapper {
      width: 100%;
      max-width: 420px;
      margin: auto;
      position: relative;
      z-index: 1;
    }
    .login-card {
      width: 100%;
      background: rgba(255,255,255,0.98);
      border-radius: 20px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.35), 0 0 0 1px rgba(255,255,255,0.1);
      overflow: hidden;
    }
    .login-header {
      background: linear-gradient(135deg, #0f3d2e, #14533e);
      padding: 2.25rem 1.75rem 1.75rem;
      text-align: center;
      color: white;
    }
    .login-logo {
      width: 60px; height: 60px;
      object-fit: contain;
      margin-bottom: 0.75rem;
      filter: brightness(0) invert(1);
    }
    .login-header h1 {
      font-size: 1.35rem;
      font-weight: 700;
      margin: 0 0 0.25rem;
      letter-spacing: -0.01em;
    }
    .login-header p {
      font-size: 0.85rem;
      opacity: 0.85;
      margin: 0;
    }
    .login-body {
      padding: 2rem 1.75rem;
    }
    .form-control {
      border-radius: 10px;
      border: 1.5px solid #e2e8f0;
      padding: 0.75rem 1rem;
      font-size: 1rem; /* 16px prevents iOS auto-zoom */
      line-height: 1.5;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-control:focus {
      border-color: #0f3d2e;
      box-shadow: 0 0 0 3px rgba(15,61,46,0.15);
    }
    .ds-form-label {
      font-size: 0.82rem;
      font-weight: 600;
      color: #2d3748;
      margin-bottom: 6px;
      display: block;
    }
    .btn-login {
      width: 100%;
      background: linear-gradient(135deg, #0f3d2e, #14533e);
      color: white;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      padding: 0.8rem 1rem;
      font-size: 1rem;
      min-height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: all 0.2s ease;
    }
    .btn-login:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(15,61,46,0.35);
      color: white;
    }
    .btn-login:active {
      transform: translateY(0);
    }
    .error-alert {
      background: #fff0f0;
      border: 1px solid #f5c2c2;
      color: #c0392b;
      border-radius: 10px;
      padding: 0.65rem 1rem;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }
    .password-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }
    .password-wrapper .form-control {
      padding-right: 46px;
    }
    .password-toggle {
      position: absolute;
      right: 4px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: #888;
      cursor: pointer;
      padding: 8px;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      transition: color 0.2s, background-color 0.2s;
    }
    .password-toggle:hover {
      color: #0f3d2e;
      background-color: rgba(0,0,0,0.04);
    }
    .login-footer {
      text-align: center;
      padding: 1.25rem 1.5rem;
      font-size: 0.78rem;
      color: #718096;
      border-top: 1px solid #edf2f7;
      background: #fafbfc;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }
    .btn-home {
      border-radius: 8px;
      padding: 6px 16px;
      font-size: 0.82rem;
      font-weight: 600;
      color: #4a5568;
      border: 1.5px solid #cbd5e1;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      text-decoration: none;
      transition: all 0.2s ease;
      background-color: white;
    }
    .btn-home:hover {
      background-color: #f1f5f9;
      border-color: #94a3b8;
      color: #1e293b;
    }
    .footer-copyright {
      line-height: 1.45;
      text-align: center;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      color: #4a5568;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      margin-top: 1.25rem;
      padding: 6px 12px;
      border-radius: 8px;
      transition: color 0.2s, background-color 0.2s;
    }
    .back-link:hover {
      color: #0f3d2e;
      background-color: rgba(15,61,46,0.06);
    }
    /* ── Mobile responsive ── */
    @media (max-width: 480px) {
      body {
        padding: 0.75rem;
      }
      .login-wrapper {
        max-width: 100%;
      }
      .login-card {
        border-radius: 16px;
      }
      .login-header {
        padding: 1.75rem 1.25rem 1.25rem;
      }
      .login-header h1 {
        font-size: 1.2rem;
      }
      .login-header p {
        font-size: 0.8rem;
      }
      .login-logo {
        width: 52px;
        height: 52px;
        margin-bottom: 0.5rem;
      }
      .login-body {
        padding: 1.5rem 1.25rem;
      }
      .login-footer {
        padding: 1rem 1.25rem;
      }
      .form-control {
        font-size: 1rem;
        padding: 0.7rem 0.9rem;
      }
      .btn-login {
        padding: 0.75rem 1rem;
        font-size: 0.98rem;
        min-height: 48px;
      }
    }
    @media (max-width: 360px) {
      body {
        padding: 0.5rem;
      }
      .login-header {
        padding: 1.5rem 1rem 1rem;
      }
      .login-header h1 {
        font-size: 1.1rem;
      }
      .login-body {
        padding: 1.25rem 1rem;
      }
      .login-footer {
        padding: 0.85rem 0.75rem;
        font-size: 0.74rem;
      }
    }
  </style>
</head>

<body>
  <div class="login-wrapper">
    <div class="login-card">
      <div class="login-header">
        <img src="/images/Gemini_Generated_Image_41luhh41luhh41lu-removebg-preview.png" alt="SYS Logo" class="login-logo">
        <h1>SYS Kozhikode South</h1>
        <p>Super Admin Portal Access</p>
      </div>

      <div class="login-body">
        {{#if loginError}}
        <div class="error-alert">
          <i class="ph ph-warning-circle me-1"></i> {{loginError}}
        </div>
        {{/if}}

        <form action="/admin/login" method="post" id="login-form">
          <div class="mb-3">
            <label class="ds-form-label" for="username-input">Admin Username</label>
            <input type="text" class="form-control" id="username-input" name="username"
              placeholder="e.g. admin" autocomplete="username" required>
          </div>

          <div class="mb-4">
            <label class="ds-form-label" for="password-input">Password</label>
            <div class="password-wrapper">
              <input type="password" class="form-control" id="password-input" name="password"
                placeholder="Enter Password" autocomplete="current-password" required>
              <button type="button" class="password-toggle" id="toggle-pw" aria-label="Toggle password">
                <i class="ph ph-eye" id="pw-icon"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-login" id="btn-submit">
            <i class="ph ph-sign-in me-1"></i> Log In
          </button>
        </form>

        <div class="text-center">
          <a href="/login" class="back-link">
            <i class="ph ph-arrow-left"></i> Unit User Login
          </a>
        </div>
      </div>

      <div class="login-footer">
        <a href="/" class="btn-home">
          <i class="ph ph-house"></i> Home
        </a>
        <div class="footer-copyright">
          &copy; 2026 Sunni Yuvajana Sangham (SYS) Kerala &bull; Admin Portal
        </div>
      </div>
    </div>
  </div>

  <script src="/javascripts/pwa.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Password toggle
    document.getElementById('toggle-pw').addEventListener('click', () => {
      const inp = document.getElementById('password-input');
      const icon = document.getElementById('pw-icon');
      const show = inp.type === 'password';
      inp.type = show ? 'text' : 'password';
      icon.className = show ? 'ph ph-eye-slash' : 'ph ph-eye';
    });
  </script>
</body>
</html>
