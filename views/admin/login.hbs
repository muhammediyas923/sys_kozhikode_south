<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | SYS Kozhikode South</title>
  <meta name="description" content="Secure administration access for SYS Kozhikode South.">
  <meta name="robots" content="noindex, nofollow">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/variables.css">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      margin: 0;
      background: linear-gradient(135deg, #0e1e38 0%, #1a365d 50%, #2a4365 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      position: relative;
      overflow: hidden;
    }
    body::before {
      content: '';
      position: absolute;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 70%);
      top: -200px; right: -150px;
      border-radius: 50%;
    }
    .login-wrapper {
      width: 100%;
      max-width: 420px;
      position: relative;
      z-index: 1;
    }
    .login-card {
      background: rgba(255,255,255,0.97);
      border-radius: 20px;
      box-shadow: 0 25px 60px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.1);
      overflow: hidden;
    }
    .login-header {
      background: linear-gradient(135deg, #1a365d, #2b6cb0);
      padding: 2.5rem 2rem 2rem;
      text-align: center;
      color: white;
    }
    .login-logo {
      width: 64px; height: 64px;
      object-fit: contain;
      margin-bottom: 0.75rem;
      filter: brightness(0) invert(1);
    }
    .login-header h1 {
      font-size: 1.4rem;
      font-weight: 700;
      margin: 0 0 0.25rem;
    }
    .login-header p {
      font-size: 0.85rem;
      opacity: 0.8;
      margin: 0;
    }
    .login-body {
      padding: 2.5rem 2rem;
    }
    .form-control {
      border-radius: 10px;
      border: 1.5px solid #e0e0e0;
      padding: 0.65rem 1rem;
      font-size: 0.95rem;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-control:focus {
      border-color: #2b6cb0;
      box-shadow: 0 0 0 3px rgba(43,108,176,0.15);
    }
    .ds-form-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: #2d3748;
      margin-bottom: 6px;
      display: block;
    }
    .btn-login {
      width: 100%;
      background: linear-gradient(135deg, #1a365d, #2b6cb0);
      color: white;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      padding: 0.75rem;
      font-size: 1rem;
      transition: all 0.2s ease;
    }
    .btn-login:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(26,54,93,0.35); color: white; }
    .error-alert {
      background: #fff0f0;
      border: 1px solid #f5c2c2;
      color: #c0392b;
      border-radius: 10px;
      padding: 0.65rem 1rem;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }
    .password-wrapper { position: relative; }
    .password-toggle {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: #999; cursor: pointer; padding: 4px;
    }
    .password-toggle:hover { color: #1a365d; }
    .login-footer {
      text-align: center;
      padding: 1rem 2rem 1.5rem;
      font-size: 0.8rem;
      color: #999;
      border-top: 1px solid #f0f0f0;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: #4a5568;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      margin-top: 1rem;
      transition: color 0.2s;
    }
    .back-link:hover {
      color: #1a365d;
    }
    /* ── Mobile responsive ── */
    @media (max-width: 480px) {
      body { padding: 0.75rem; align-items: flex-start; padding-top: 2rem; }
      .login-header { padding: 1.75rem 1.25rem 1.5rem; }
      .login-header h1 { font-size: 1.2rem; }
      .login-logo { width: 52px; height: 52px; }
      .login-body { padding: 1.5rem 1.25rem; }
      .login-footer { padding: 0.75rem 1.25rem 1.25rem; }
      .form-control { font-size: 1rem; padding: 0.7rem 1rem; } /* prevent iOS zoom */
      .btn-login { padding: 0.85rem; font-size: 1rem; }
    }
  </style>
</head>

<body>
  <div class="login-wrapper">
    <div class="login-card">
      <div class="login-header">
        <img src="/images/Gemini_Generated_Image_41luhh41luhh41lu-removebg-preview.png" alt="SYS Logo" class="login-logo">
        <h1>SYS Kozhikode South</h1>
        <p>Super Admin Portal Access</p>
      </div>

      <div class="login-body">
        {{#if loginError}}
        <div class="error-alert">
          <i class="ph ph-warning-circle me-1"></i> {{loginError}}
        </div>
        {{/if}}

        <form action="/admin/login" method="post" id="login-form">
          <div class="mb-3">
            <label class="ds-form-label" for="username-input">Admin Username</label>
            <input type="text" class="form-control" id="username-input" name="username"
              placeholder="e.g. superadmin" autocomplete="username" required>
          </div>

          <div class="mb-4">
            <label class="ds-form-label" for="password-input">Password</label>
            <div class="password-wrapper">
              <input type="password" class="form-control" id="password-input" name="password"
                placeholder="••••••••" autocomplete="current-password" required>
              <button type="button" class="password-toggle" id="toggle-pw" aria-label="Toggle password">
                <i class="ph ph-eye" id="pw-icon"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-login" id="btn-submit">
            <i class="ph ph-sign-in me-1"></i> Log In
          </button>
        </form>

        <div class="text-center">
          <a href="/login" class="back-link">
            <i class="ph ph-arrow-left"></i> Unit User Login
          </a>
        </div>
      </div>

      <div class="login-footer">
        &copy; 2026 Sunni Yuvajana Sangham (SYS) Kerala &mdash; Admin Portal
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Password toggle
    document.getElementById('toggle-pw').addEventListener('click', () => {
      const inp = document.getElementById('password-input');
      const icon = document.getElementById('pw-icon');
      const show = inp.type === 'password';
      inp.type = show ? 'text' : 'password';
      icon.className = show ? 'ph ph-eye-slash' : 'ph ph-eye';
    });
  </script>
</body>
</html>
