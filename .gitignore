# Dependencies
node_modules/

# Environment and Secret Files
.env
.env*.local
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
error-log.txt

# OS Temporary Files
.DS_Store
Thumbs.db

# Uploads temporary files if needed
uploads/temp/

# Storage and Backups (Prevent database dumps from being committed)
storage/
storage/backups/
*.zip

# Public Uploads (User-uploaded evidence and attachments)
public/uploads/completions/*
public/uploads/programs/*
!public/uploads/**/.gitkeep

