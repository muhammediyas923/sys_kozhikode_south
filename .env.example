# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ==========================================
# DATABASE CONFIGURATION (MongoDB)
# ==========================================
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sys

# ==========================================
# AUTH / SESSION CONFIGURATION
# ==========================================
# In production, generate a secure random 64-character secret
SESSION_SECRET=

# ==========================================
# RAZORPAY PAYMENT GATEWAY
# ==========================================
# Options: test | live
PAYMENT_MODE=test
# Razorpay Key ID from Dashboard (rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID=
# Razorpay Key Secret from Dashboard (Keep strictly secret!)
RAZORPAY_KEY_SECRET=
# Razorpay Webhook Secret for signature validation
RAZORPAY_WEBHOOK_SECRET=
# Currency code
RAZORPAY_CURRENCY=INR

# ==========================================
# INITIAL SUPER ADMIN SEEDING
# (Only used on first startup if no Super Admin user exists)
# ==========================================
SUPER_ADMIN_USERNAME=sysadmin
SUPER_ADMIN_PASSWORD=
